{
  "components": {
    "CommandRegisterProject": {
      "properties": {
        "project_id": {
          "type": "string",
          "title": "Project Id",
          "description": "Short and stable, e.g. ``acme-sales``."
        },
        "tenant_id": {
          "type": "string",
          "title": "Tenant Id",
          "description": "Empty: the project is grouped with no tenant yet.",
          "default": ""
        },
        "display_name": {
          "type": "string",
          "title": "Display Name"
        },
        "project_repositories": {
          "items": {
            "$ref": "#/components/schemas/ProjectRepositorySpec"
          },
          "type": "array",
          "title": "Project Repositories"
        },
        "specification": {
          "$ref": "#/components/schemas/ProjectSpecification"
        },
        "inventory": {
          "$ref": "#/components/schemas/ProjectInventory"
        },
        "channels": {
          "items": {
            "$ref": "#/components/schemas/ProjectChannelSpec"
          },
          "type": "array",
          "title": "Channels"
        }
      },
      "type": "object",
      "required": ["project_id", "display_name", "project_repositories"],
      "title": "CommandRegisterProject"
    },
    "ProjectSpecification": {
      "properties": {
        "host": {
          "type": "string",
          "title": "Host",
          "default": "local"
        },
        "preparation": {
          "$ref": "#/components/schemas/ProjectPreparation"
        },
        "review_host": {
          "type": "string",
          "enum": ["github", ""],
          "title": "Review Host",
          "default": ""
        },
        "review_cli": {
          "type": "string",
          "title": "Review Cli",
          "default": "gh"
        },
        "agent_binary": {
          "type": "string",
          "title": "Agent Binary",
          "default": "claude"
        },
        "agent_model": {
          "type": "string",
          "title": "Agent Model",
          "default": ""
        },
        "language": {
          "type": "string",
          "enum": ["es", "en"],
          "title": "Language",
          "default": "es"
        },
        "verification_checks": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "title": "Verification Checks",
          "default": []
        },
        "engineer_review": {
          "type": "boolean",
          "title": "Engineer Review",
          "default": false
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "ProjectSpecification"
    },
    "ProjectPreparation": {
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/components/schemas/ArtifactTransfer"
          },
          "type": "array",
          "title": "Artifacts",
          "default": []
        },
        "probes": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "title": "Probes",
          "default": []
        },
        "health_checks": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "title": "Health Checks",
          "default": []
        },
        "health_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "title": "Health Timeout Seconds",
          "default": 60
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "ProjectPreparation"
    },
    "ProjectInventory": {
      "properties": {
        "components": {
          "items": {
            "$ref": "#/components/schemas/ProjectComponent"
          },
          "type": "array",
          "title": "Components",
          "default": []
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "ProjectInventory"
    },
    "ProjectComponent": {
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "title": "Name"
        },
        "kind": {
          "$ref": "#/components/schemas/ComponentKind"
        },
        "code_repository": {
          "type": "string",
          "minLength": 1,
          "title": "Code Repository"
        },
        "path": {
          "type": "string",
          "title": "Path",
          "default": ""
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "title": "Dependencies",
          "default": []
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["name", "kind", "code_repository"],
      "title": "ProjectComponent"
    },
    "ComponentKind": {
      "type": "string",
      "enum": ["application", "service", "library", "module", "worker"],
      "title": "ComponentKind"
    },
    "ProjectChannelSpec": {
      "properties": {
        "channel": {
          "type": "string",
          "title": "Channel"
        },
        "thread": {
          "type": "string",
          "title": "Thread"
        }
      },
      "type": "object",
      "required": ["channel", "thread"],
      "title": "ProjectChannelSpec"
    },
    "ProjectRepositorySpec": {
      "properties": {
        "url": {
          "type": "string",
          "title": "Url"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "base_branch": {
          "type": "string",
          "title": "Base Branch",
          "default": "main"
        },
        "writable": {
          "type": "boolean",
          "title": "Writable",
          "default": true
        }
      },
      "type": "object",
      "required": ["url"],
      "title": "ProjectRepositorySpec"
    },
    "ArtifactTransfer": {
      "properties": {
        "source": {
          "$ref": "#/components/schemas/ArtifactLocation"
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "title": "Destination"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["source", "destination"],
      "title": "ArtifactTransfer"
    }
  },

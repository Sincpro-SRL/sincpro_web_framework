{
  "name": "@sincpro/web-framework",
  "version": "2.0.0",
  "description": "The web client of sincpro_framework: entities, lists and records bound to the metadata the server publishes, drawn with @sincpro/web-ui and arranged with @sincpro/web-composer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "default": "./dist/telemetry/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "prettier": {
    "printWidth": 94
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-trace": "^3.1.0",
    "@sentry/browser": "^11.11.0",
    "@sincpro/client-framework": "^0.2.0",
    "@sincpro/criteria": "^2.0.0",
    "@sincpro/criteria-react": "^2.0.0",
    "@sincpro/web-composer": "^1.5.0",
    "@sincpro/web-ui": "^2.0.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/sdk-trace": {
      "optional": true
    },
    "@sentry/browser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "@sentry/browser": "11.11.0",
    "@sincpro/client-framework": "^0.2.0",
    "@sincpro/criteria": "^2.0.0",
    "@sincpro/criteria-react": "^2.0.0",
    "@sincpro/web-composer": "^1.5.0",
    "@sincpro/web-ui": "^2.0.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-mcp": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.24",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "tsc-alias": "^1.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "keywords": [
    "sincpro",
    "sincpro-framework",
    "react",
    "metadata",
    "criteria",
    "erp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sincpro-SRL/sincpro_web_framework.git"
  },
  "author": "Gutierrez, Andres <andres.gutierrez@sincpro.com.bo>",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "lucide-react": "^1.45.0"
  }
}
